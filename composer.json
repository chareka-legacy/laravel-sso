{
    "name": "laravel-auto/sso",
    "version": "1.0.0",
    "description": "Simple PHP SSO integration for Laravel",
    "keywords": ["laravel", "sso", "authentication", "login"],
    "homepage": "https://github.com/chareka-legacy/laravel-sso",
    "license": "MIT",
    "authors": [
      {
        "name": "Martynas Žaliaduonis",
        "email": "m.zaliaduonis@gmail.com",
        "homepage": "https://github.com/zefy",
        "role": "Developer"
      },
      {
        "name": "Joseph Charika",
        "email": "joecharika@gmail.com",
        "homepage": "https://github.com/jcharika",
        "role": "Developer"
      }
    ],
    "require": {
        "php": ">=8.0",
        "guzzlehttp/guzzle": "^7.0",
        "laravel/framework": ">=10.0",
        "zefy/php-simple-sso": "^1.0"
    },
    "autoload": {
      "psr-4": {
        "LaravelAuto\\Sso\\": "src/"
      }
    },
    "extra": {
      "laravel": {
        "providers": [
            "LaravelAuto\\Sso\\SingleSignOnServiceProvider"
        ]
      }
    },
    "config": {
        "allow-plugins": {
            "kylekatarnls/update-helper": true
        }
    }
}
